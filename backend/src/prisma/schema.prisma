generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyIndex {
  id              Int      @id @default(autoincrement())
  date            DateTime
  jevonsIndexValue Float
  totalDataPoints Int
}

model ScrapeLog {
  id               Int      @id @default(autoincrement())
  timestamp        DateTime
  origin           String
  destination      String
  carrier          String
  advanceWindow    String
  baseFare         Float?
  taxGST           Float?
  taxUDF           Float?
  totalFare        Float?
  provenanceStatus String
}
