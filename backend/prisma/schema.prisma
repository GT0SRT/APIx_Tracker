datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Airports
model Airport {
  id              Int       @id @default(autoincrement())
  iataCode        String    @unique // e.g. "DEL", "BOM", "BLR"
  city            String    // e.g. "Delhi", "Mumbai"
  airportName     String    // e.g. "Indira Gandhi International Airport"
  state           String
  departingRoutes Route[]   @relation("OriginAirport")
  arrivingRoutes  Route[]   @relation("DestinationAirport")
  createdAt       DateTime  @default(now())

  @@index([iataCode])
}

// 2. Airlines / Carriers
model Airline {
  id            Int               @id @default(autoincrement())
  code          String            @unique // e.g. "6E", "AI", "QP", "SG"
  name          String            // "IndiGo", "Air India", "Akasa Air"
  brandColor    String?           // Hex color for UI charts
  isActive      Boolean           @default(true)
  observations  FareObservation[]
  createdAt     DateTime          @default(now())

  @@index([code])
}

// 3. Official DGCA City-Pair Routes & Quarterly Traffic Weights (w_r)
model Route {
  id               Int               @id @default(autoincrement())
  originCode       String            // "DEL"
  origin           Airport           @relation("OriginAirport", fields: [originCode], references: [iataCode])
  destinationCode  String            // "BOM"
  destination      Airport           @relation("DestinationAirport", fields: [destinationCode], references: [iataCode])
  routeCode        String            @unique // "DEL-BOM"
  dgcaWeight       Float             // Quarterly passenger traffic volume share (w_r), e.g. 0.142
  distanceKm       Int?              // Distance in km
  isTrunkRoute     Boolean           @default(true)
  isActive         Boolean           @default(true)
  observations     FareObservation[]
  dailyIndices     DailyRouteIndex[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([originCode, destinationCode])
  @@index([routeCode])
}

// 4. Raw Cleaned Fare Observations (Scraped every 6 hours via Playwright)
model FareObservation {
  id               BigInt         @id @default(autoincrement())
  timestamp        DateTime       @default(now())
  routeId          Int
  route            Route          @relation(fields: [routeId], references: [id])
  airlineId        Int
  airline          Airline        @relation(fields: [airlineId], references: [id])
  flightNumber     String         // e.g. "6E-204"
  departureDate    DateTime       // Date of flight departure
  advanceWindow    String         // "T+1", "T+7", "T+15", "T+30", "T+45"
  baseFare         Float          // Pure base airfare
  fuelSurcharge    Float          @default(0) // Fuel tax (YQ/YR)
  airportTaxUDF    Float          @default(0) // User Development Fee
  taxGST           Float          @default(0) // Goods & Services Tax
  totalFare        Float          // Final consumer price
  isOutlier        Boolean        @default(false) // Filtered via IQR
  provenanceStatus String         @default("CLEANED") // "CLEANED", "FLAGGED", "SOLD_OUT_IMPUTED"
  sha256Hash       String         @unique // Cryptographic hash of scrape record

  @@index([routeId, departureDate, advanceWindow])
  @@index([timestamp])
  @@index([advanceWindow])
}

// 5. Computed Jevons Route Micro-Index (Daily Elementary Geometric Aggregation)
model DailyRouteIndex {
  id               Int            @id @default(autoincrement())
  date             DateTime       @db.Date
  routeId          Int
  route            Route          @relation(fields: [routeId], references: [id])
  advanceWindow    String         // "T+1", "T+7", "T+15", "T+30", "T+45", "COMPOSITE"
  jevonsIndexValue Float          // I_J(t/0) geometric mean of price relatives
  sampleCount      Int            // Number of flight observations used
  avgBaseFare      Float
  minFare          Float?
  maxFare          Float?
  createdAt        DateTime       @default(now())

  @@unique([date, routeId, advanceWindow])
  @@index([date])
  @@index([routeId])
}

// 6. National Composite Macro APIx (For MoSPI / RBI Transport Inflation)
model MacroDailyIndex {
  id               Int            @id @default(autoincrement())
  date             DateTime       @unique @db.Date
  compositeIndex   Float          // \sum w_r * I_r(t/0)
  baselineIndex    Float          @default(100.0) // CPI base comparison
  volatilityRating String         @default("Moderate") // "Low", "Moderate", "High"
  totalDataPoints  Int            @default(0)
  momInflation     Float?         // Month-on-Month % inflation change
  yoyInflation     Float?         // Year-on-Year % inflation change
  createdAt        DateTime       @default(now())

  @@index([date])
}

// 7. Automated Scraper Pipeline & Audit Run Logs
model ScraperRunLog {
  id               Int            @id @default(autoincrement())
  runStartedAt     DateTime       @default(now())
  runFinishedAt    DateTime?
  status           String         @default("RUNNING") // "SUCCESS", "PARTIAL_FAILURE", "FAILED"
  totalScraped     Int            @default(0)
  validRecords     Int            @default(0)
  outliersFiltered Int            @default(0)
  batchSha256      String?
  errorMessage     String?
  sourcePortal     String?        // "DIRECT_CARRIERS", "OTA_AGGREGATOR"

  @@index([runStartedAt])
}

// 8. Admin User Model (Single-Role Admin Access)
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  role          String   @default("ADMIN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}
