{
  "name": "apix-backend",
  "version": "1.0.0",
  "description": "AndroMatrix APIx Tracker Backend & Database Service for MoSPI / RBI",
  "main": "server.js",
  "scripts": {
    "build": "prisma generate",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "prisma generate && (pip3 install -r ml/requirements.txt || pip install -r ml/requirements.txt || true)",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:cpi": "node prisma/seed_cpi.js",
    "ml:forecast": "python ml/cpi_forecaster.py",
    "seed:admin": "node scripts/seed_admin.js",
    "cpi:import:2026": "node scripts/import_cpi_data.js --seed-2026",
    "db:reset": "node scripts/reset_db.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
