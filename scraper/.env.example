# APIx Tracker - Scraper Environment Variables

# Backend Ingestion REST API endpoint
BACKEND_API_URL=http://localhost:5000

# Secret authorization token for data ingestion (matches backend)
INGEST_SECRET=apix_secret_token_sih2026

# Scraper Settings
SCRAPER_PORTAL=google_flights
SCRAPER_CONCURRENCY=3
HEADLESS=true
EXPORT_LOCAL_BACKUP=true

# Outlier Filter Thresholds
IQR_MULTIPLIER=1.5
HAMPEL_WINDOW=7
HAMPEL_SIGMA=3.0

# Anti-Bot Resilience & Proxy Configuration (Optional)
# Supports residential or rotating proxy URLs (e.g., http://user:pass@gate.smartproxy.com:7000)
RESIDENTIAL_PROXY_URL=
ROTATING_PROXY_URL=
PROXY_URL=

# Circuit Breaker Overrides (Optional)
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=21600
SCRAPER_MAX_RETRIES=3

# Tier 3 Third-Party Scraping API Keys (Optional)
SCRAPER_TIER3_ENABLED=false
SCRAPINGBEE_API_KEY=
SCRAPERAPI_KEY=

# Automated Gmail SMTP Incident Alerting (GitHub Actions Secrets)
# In GitHub Repo Settings -> Secrets and variables -> Actions:
# SMTP_USERNAME: your.gmail.address@gmail.com
# SMTP_PASSWORD: your-gmail-app-password
# ALERT_RECIPIENT_EMAIL: alerts-receiver@yourdomain.com
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
